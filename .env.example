# Supabase (Project settings → API). Service role key stays server-side only.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Password for /admin
ADMIN_PASSWORD=

# Optional
EMBED_MODEL=openai/text-embedding-3-small
APP_URL=https://your-app.vercel.app

# Secrets for clients' live API tools. Reference as {{env.TOOL_...}} in a tool's url/headers.
# TOOL_ACME_ORDERS_KEY=
